# mcp.conf.j2
# [TEMPLATE] .j2 version of nginx default.conf Config file, setup by default to integrate with MCP server.

server {
    listen 80;

    location {{ mcp_server_path }} {
        proxy_pass http://127.0.0.1:{{ mcp_server_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
